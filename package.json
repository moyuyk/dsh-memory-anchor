{
  "name": "dsh-memory-anchor",
  "version": "0.1.0",
  "description": "跨会话长期记忆：摘要进 SQLite，原文只存锚点、按需回源会话日志；不调模型、不联网、零运行时依赖。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-memory-anchor": "bin/mem.js"
  },
  "files": [
    "lib",
    "bin/mem.js",
    "bin/package.json",
    "bin/lib/store.js",
    "bin/lib/session-log.js",
    "bin/lib/messages.js",
    "bin/lib/extract.js",
    "bin/lib/logsearch.js",
    "bin/lib/wrapup.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg",
    "CHANGELOG.md",
    "SECURITY.md",
    "PROMPTS.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "sqlite",
    "fts5",
    "local-first",
    "anchored",
    "session-log"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "marketplace": {
      "profiles": [
        "desktop"
      ],
      "requiresRestart": true,
      "requiresBuildApproval": false,
      "manualSteps": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyuyk/dsh-memory-anchor.git"
  },
  "homepage": "https://github.com/moyuyk/dsh-memory-anchor#readme",
  "bugs": {
    "url": "https://github.com/moyuyk/dsh-memory-anchor/issues"
  },
  "author": "dsh-memory-anchor contributors"
}
